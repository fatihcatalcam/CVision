{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pricing.md",
      "destination": "https://cvision-p4ny.onrender.com/payment/pricing.md"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
